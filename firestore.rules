rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────
    // Admin identity is by EMAIL, never Google/UID. There is NO email
    // sending anywhere in this app (no verification link, no password
    // reset) — trust instead comes entirely from the owner-controlled
    // allowlist, checked before an admin account can ever do anything:
    //   1. A tiny hardcoded bootstrap list (paste the SAME lowercase
    //      email(s) as ADMIN_EMAILS in firebase-init.js) — how the
    //      very first admin gets in, since nobody exists yet to add
    //      them.
    //   2. Anyone with an approved doc in adminEmails/{email} — written
    //      by admin-access.html (owner adds/removes admins by email)
    //      and by owner-setup.html (the one-time owner claim). An
    //      account can only be created for an email once the owner has
    //      approved it here (see admin.html's createpw-btn handler).
    // ───────────────────────────────────────────────────────────
    function authedEmail() {
      return request.auth != null && request.auth.token.email is string;
    }
    function ownEmail() { return request.auth.token.email.lower(); }
    // A guest placing a bid must be signed in with a real Google account —
    // never anonymous, never a bare uid with no verified provider. This is
    // the server-side half of "every bid has a mandatory user id": the
    // client can't spoof it, since request.auth comes from Firebase's own
    // verified ID token, not from anything the page sends.
    // Email-only guests sign in with Firebase "anonymous" auth (no password);
    // the email they type is NOT verified, and they are banned by device id.
    function isGuest() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function isVerifiedBidder() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider in ['google.com', 'anonymous'];
    }
    function isAdmin() {
      return authedEmail() && (
        ownEmail() in [
          // "you@example.com",
        ]
        || (exists(/databases/$(database)/documents/adminEmails/$(ownEmail())) &&
            get(/databases/$(database)/documents/adminEmails/$(ownEmail())).data.approved == true)
      );
    }
    function isOwner() {
      return authedEmail() &&
        exists(/databases/$(database)/documents/settings/owner) &&
        get(/databases/$(database)/documents/settings/owner).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/settings/owner).data.email == ownEmail();
    }
    // True only while no owner has been claimed yet AND this write would
    // itself create that owner record for the signed-in user — lets
    // owner-setup.html's one-time claim happen without a chicken-and-egg
    // "you must already be owner to become owner" problem.
    function bootstrapping() {
      return authedEmail() &&
        !exists(/databases/$(database)/documents/settings/owner) &&
        getAfter(/databases/$(database)/documents/settings/owner).data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/settings/owner).data.email == ownEmail();
    }

    // Created once by owner-setup.html's one-time claim, keyed uid+email
    // so it can never silently point at a different account later.
    match /settings/owner {
      allow get: if isOwner();
      allow create: if authedEmail() &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'setupKey', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.email == ownEmail() &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.setupKey is string &&
        request.resource.data.setupKey.matches('^[a-zA-Z0-9_-]{20,128}$') &&
        get(/databases/$(database)/documents/setupKeys/$(request.resource.data.setupKey)).data.enabled == true &&
        getAfter(/databases/$(database)/documents/setupKeys/$(request.resource.data.setupKey)).data.enabled == false &&
        getAfter(/databases/$(database)/documents/adminEmails/$(ownEmail())).data.role == 'owner' &&
        getAfter(/databases/$(database)/documents/adminEmails/$(ownEmail())).data.approved == true;
      allow update, delete, list: if false;
    }

    // Created only in the Firebase console (Firestore → Data → Start
    // collection "setupKeys" → doc with `enabled: true`). Never readable
    // or creatable from the browser — consuming it and writing the first
    // owner record must happen atomically in the same batch as above.
    match /setupKeys/{key} {
      allow read, create, delete: if false;
      allow update: if bootstrapping() && resource.data.enabled == true &&
        getAfter(/databases/$(database)/documents/settings/owner).data.setupKey == key &&
        request.resource.data.keys().hasOnly(['enabled']) && request.resource.data.enabled == false;
    }

    // admin-access.html: owner adds/removes organizers by email here.
    // The owner's own row can never be edited/removed through this path.
    function initialOwnerApproval(email) {
      return bootstrapping() && email == ownEmail() &&
        request.resource.data.keys().hasOnly(['email', 'approved', 'role', 'updatedBy', 'updatedAt']) &&
        request.resource.data.email == ownEmail() && request.resource.data.approved == true &&
        request.resource.data.role == 'owner' && request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }
    function validApproval(email) {
      return request.resource.data.keys().hasOnly(['email', 'approved', 'role', 'updatedBy', 'updatedAt']) &&
        email == email.lower() && email.size() <= 254 &&
        email.matches('^[^ @/]+@[^ @/]+[.][^ @/]+$') &&
        request.resource.data.email == email &&
        request.resource.data.approved == true &&
        request.resource.data.role == 'admin' &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }
    match /adminEmails/{email} {
      // Public get (not list): admin.html's create-password flow must be
      // able to check "is THIS exact email approved?" before an account
      // even exists for it — there is no signed-in user yet to compare
      // against, and there's no server-side function to gate account
      // creation at the Auth level, so this doc is the only way to
      // decide, and it holds nothing more sensitive than an email address
      // an organizer already typed into the owner's Admin Access page.
      allow get: if true;
      allow list: if isOwner();
      allow create: if (isOwner() && validApproval(email)) || initialOwnerApproval(email);
      allow update: if (isOwner() && resource.data.role != 'owner' && email != ownEmail() && validApproval(email)) || initialOwnerApproval(email);
      allow delete: if isOwner() && resource.data.role != 'owner' && email != ownEmail();
    }

    // Legacy: an older build briefly wrote admin approvals to admins/{email}
    // (Google-sign-in era). That collection is no longer read by the app —
    // locked out entirely rather than left as a stale backdoor. Re-add
    // anyone who was only approved there through Admin Access instead.
    match /admins/{email} { allow read, write: if false; }

    // Per-account bid cooldown. Keyed by the signed-in uid (NOT a device id,
    // which anyone could read off a bid doc and abuse). Each write must set
    // lastBidAt to the server's own request.time, and a later write must come
    // at least 3 seconds after the previous one. The bid-create rule below
    // requires this write in the same transaction, so it can't be skipped.
    // Also carries an optional bannedUntil: written (as its own, separate
    // write — see triggerBan() in firebase-init.js) when an account
    // attempts a bid at or above BAN_THRESHOLD (₹1,00,000). The real
    // enforcement is amountUnderBan() below, rejecting the bid itself
    // server-side regardless of whether this write succeeds; this ban
    // doc on top of that stops the account from placing ANY further bid
    // (even a small one) until it expires.
    match /bidLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if isVerifiedBidder() && request.auth.uid == uid &&
        (
          (request.resource.data.keys().hasOnly(['lastBidAt']) &&
           request.resource.data.lastBidAt == request.time) ||
          (request.resource.data.keys().hasOnly(['bannedUntil']) &&
           request.resource.data.bannedUntil is timestamp &&
           request.resource.data.bannedUntil > request.time &&
           request.resource.data.bannedUntil <= request.time + duration.value(6, 'm'))
        );
      allow update: if isVerifiedBidder() && request.auth.uid == uid &&
        (
          (request.resource.data.keys().hasOnly(['lastBidAt']) &&
           request.resource.data.lastBidAt == request.time &&
           request.time >= resource.data.get('lastBidAt', timestamp.date(1970,1,1)) + duration.value(3, 's')) ||
          (request.resource.data.keys().hasOnly(['bannedUntil']) &&
           request.resource.data.bannedUntil is timestamp &&
           request.resource.data.bannedUntil > request.time &&
           request.resource.data.bannedUntil <= request.time + duration.value(6, 'm'))
        );
    }
    function isBanned(uid) {
      return exists(/databases/$(database)/documents/bidLimits/$(uid)) &&
        get(/databases/$(database)/documents/bidLimits/$(uid)).data.get('bannedUntil', request.time) > request.time;
    }

    // Retired: the per-device block (keyed by a value anyone could read off
    // a bid doc and dodge by changing deviceId) has been replaced by the
    // per-account ban in bidLimits/{uid} above, plus the BAN_THRESHOLD
    // rejection in commonBid() below. Only admins may clear leftover docs.
    // Re-enabled ONLY for email-only guests: a device that triggered a ban
    // (bid of 1,00,000 or more) can't bid as a guest until it expires. The id is
    // client-supplied, so this stops casual evasion, not a determined person.
    match /bidBlocks/{deviceId} {
      allow read: if isVerifiedBidder();
      allow create, update: if isVerifiedBidder() && deviceId.size() <= 100 &&
        request.resource.data.keys().hasOnly(['bannedUntil']) &&
        request.resource.data.bannedUntil is timestamp &&
        request.resource.data.bannedUntil > request.time &&
        request.resource.data.bannedUntil <= request.time + duration.value(6, 'm');
      allow delete: if isAdmin();
    }
    function isDeviceBanned(deviceId) {
      return exists(/databases/$(database)/documents/bidBlocks/$(deviceId)) &&
        get(/databases/$(database)/documents/bidBlocks/$(deviceId)).data.get('bannedUntil', request.time) > request.time;
    }
    // Absolute ceiling on any bid amount — an obviously-absurd value (fat-
    // fingered or malicious) is rejected outright rather than accepted.
    // (BAN_THRESHOLD in commonBid() below is a much lower, real-world
    // ceiling; this is just the final backstop.)
    function underMaxBid(amount) { return amount > 0 && amount <= 100000000; }

    // Guest profiles — unused by the current app (name/email/phone live on
    // each bid document instead) but kept available for anyone who wants
    // to build a standalone guest-profile page against it.
    // Unrelated to admin identity.
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'updatedAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 80 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$') &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 30 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Full-size photo for a lot, stored apart from the item doc so the lot
    // list (which every phone listens to) stays small. Fetched once with get
    // when a lot is opened. Public read by exact id, admin write.
    match /itemImages/{imageId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Bidding is a straight raise: only currentBid, currentBidderName,
      // currentBidderUid and bidCount may change, currentBid must clear
      // the previous bid by at least the increment, and closed lots
      // reject new bids. Admins can still edit anything (e.g. fixing
      // a typo in the description).
      // A raise also records the previous leader (prev*) and the id of the new
      // bid doc (lastBidId), so the current leader can UNDO that bid within 60
      // seconds (see bidderUndo). Keep 60 in sync with UNDO_SECONDS in index.html.
      allow update: if isAdmin() || (
        resource.data.active == true &&
        (resource.data.get('endsAt', null) == null || request.time < resource.data.endsAt) &&
        isVerifiedBidder() && (bidderRaise() || bidderUndo())
      );
      function bidderUndo() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentBid', 'currentBidderName', 'currentBidderUid', 'bidCount', 'prevKnown']) &&
          resource.data.get('prevKnown', false) == true &&
          resource.data.currentBidderUid == request.auth.uid &&
          request.resource.data.currentBid == resource.data.prevBid &&
          request.resource.data.currentBidderName == resource.data.prevBidderName &&
          request.resource.data.currentBidderUid == resource.data.prevBidderUid &&
          request.resource.data.bidCount == resource.data.bidCount - 1 &&
          request.resource.data.prevKnown == false &&
          // not in the last 10 minutes before the lot closes
          (resource.data.get('endsAt', null) == null || request.time < resource.data.endsAt - duration.value(10, 'm')) &&
          // the bid being undone: this bidder's, the current leader, under 60s old, and deleted in the same write
          get(/databases/$(database)/documents/items/$(itemId)/bids/$(resource.data.lastBidId)).data.uid == request.auth.uid &&
          get(/databases/$(database)/documents/items/$(itemId)/bids/$(resource.data.lastBidId)).data.amount == resource.data.currentBid &&
          request.time < get(/databases/$(database)/documents/items/$(itemId)/bids/$(resource.data.lastBidId)).data.timestamp + duration.value(60, 's') &&
          !existsAfter(/databases/$(database)/documents/items/$(itemId)/bids/$(resource.data.lastBidId));
      }
      function bidderRaise() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentBid', 'currentBidderName', 'currentBidderUid', 'bidCount',
                    'prevBid', 'prevBidderName', 'prevBidderUid', 'prevKnown', 'lastBidId']) &&
        request.resource.data.prevBid == resource.data.currentBid &&
        request.resource.data.prevBidderName == resource.data.get('currentBidderName', '') &&
        request.resource.data.prevBidderUid == resource.data.get('currentBidderUid', null) &&
        request.resource.data.prevKnown == true &&
        request.resource.data.lastBidId is string &&
        existsAfter(/databases/$(database)/documents/items/$(itemId)/bids/$(request.resource.data.lastBidId)) &&
        request.resource.data.currentBid is number &&
        underMaxBid(request.resource.data.currentBid) &&
        request.resource.data.currentBid >= resource.data.currentBid + resource.data.increment &&
        request.resource.data.bidCount == resource.data.get('bidCount', 0) + 1 &&
        // Bids above HOLD_THRESHOLD (₹20,000) must go through the review
        // hold (see bids below), never straight onto the lot. Keep this
        // number in sync with HOLD_THRESHOLD in firebase-init.js.
        request.resource.data.currentBid <= 20000 &&
        request.resource.data.currentBidderName is string &&
        request.resource.data.currentBidderName.size() > 0 &&
        request.resource.data.currentBidderName.size() < 80 &&
        request.resource.data.currentBidderUid == request.auth.uid;
      }

      match /bids/{bidId} {
        // Bids hold phone numbers and emails. Admins read them all; a bidder
        // can read only their own (see the collection-group rule at the
        // bottom of this file).
        allow read: if isAdmin();
        allow update: if isAdmin();
        // Admins delete anything. A bidder may withdraw their own hold
        // while it is pending or after it was revoked (so they can bid again).
        // A bidder may also delete their own normal bid within 60 seconds,
        // but only together with the matching item rollback (bidderUndo).
        allow delete: if isAdmin() || (isVerifiedBidder() &&
          resource.data.uid == request.auth.uid &&
          !('status' in resource.data) &&
          get(/databases/$(database)/documents/items/$(itemId)).data.get('lastBidId', '') == bidId &&
          get(/databases/$(database)/documents/items/$(itemId)).data.get('prevKnown', false) == true &&
          getAfter(/databases/$(database)/documents/items/$(itemId)).data.get('prevKnown', true) == false &&
          getAfter(/databases/$(database)/documents/items/$(itemId)).data.bidCount ==
            get(/databases/$(database)/documents/items/$(itemId)).data.bidCount - 1 &&
          request.time < resource.data.timestamp + duration.value(60, 's')) ||
          (request.auth != null &&
          resource.data.uid == request.auth.uid &&
          resource.data.get('status', '') in ['pending', 'revoked']);

        // Checks shared by normal bids and held bids. Phone is mandatory
        // (10 digits starting 6-9, no OTP; see PHONE_REGEX in firebase-init.js).
        // The per-account cooldown doc must be written at this same instant.
        // A bid at or above BAN_THRESHOLD (₹1,00,000) is rejected outright
        // here (amount < 100000), and an account currently serving a ban
        // (see bidLimits/{uid}.bannedUntil above) can't place ANY bid.
        // Keep 100000 in sync with BAN_THRESHOLD in firebase-init.js.
        function commonBid() {
          return request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.name.size() < 80 &&
            request.resource.data.phone is string &&
            request.resource.data.phone.matches('^[6789][0-9]{9}$') &&
            // The child the family is bidding for: name, plus EITHER a
            // class & section OR an admission number (or both) — never
            // neither. Admin-only (bids are never public), used to
            // identify the family.
            request.resource.data.childName is string &&
            request.resource.data.childName.size() > 0 &&
            request.resource.data.childName.size() < 80 &&
            // Class & section: a space or dash is REQUIRED between the
            // class number and the section (e.g. "10-B" / "10 B"), so the
            // two parts can be read back apart and tracked separately —
            // matches CLASS_SECTION_REGEX in firebase-init.js. Empty
            // string is allowed here (the admission-number half of the
            // "either/or" can cover it instead); the "at least one"
            // requirement is enforced two lines down.
            request.resource.data.classSection is string &&
            (request.resource.data.classSection == '' ||
             request.resource.data.classSection.matches('^[0-9]{1,2}[ -][A-Za-z0-9]{1,4}$')) &&
            // Admission number: exactly 4 digits, or empty (same either/or
            // as above) — matches ADMISSION_NUMBER_REGEX in firebase-init.js.
            request.resource.data.admissionNumber is string &&
            (request.resource.data.admissionNumber == '' ||
             request.resource.data.admissionNumber.matches('^[0-9]{4}$')) &&
            (request.resource.data.classSection != '' || request.resource.data.admissionNumber != '') &&
            request.resource.data.email is string &&
            request.resource.data.email.size() <= 254 &&
            ((isGuest() && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')) ||
             (!isGuest() && request.resource.data.email == request.auth.token.email)) &&
            request.resource.data.isGoogle == !isGuest() &&
            // Optional (older pages omit it): the bidder's choice on having their name announced if they win.
            (!('announceName' in request.resource.data) || request.resource.data.announceName is bool) &&
            request.resource.data.timestamp == request.time &&
            request.resource.data.amount is int &&
            request.resource.data.amount < 100000 &&
            underMaxBid(request.resource.data.amount) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.deviceId is string &&
            request.resource.data.deviceId.size() <= 100 &&
            (!isGuest() || !isDeviceBanned(request.resource.data.deviceId)) &&
            !isBanned(request.auth.uid) &&
            getAfter(/databases/$(database)/documents/bidLimits/$(request.auth.uid)).data.lastBidAt == request.time;
        }
        // A normal bid: at or below HOLD_THRESHOLD (₹20,000), tied to the
        // item update in the same transaction (same amount, same bidder,
        // bidCount + 1).
        function normalBid() {
          return request.resource.data.keys().hasOnly(
              ['name', 'phone', 'email', 'amount', 'uid', 'isGoogle', 'deviceId', 'timestamp', 'childName', 'classSection', 'admissionNumber', 'announceName']) &&
            request.resource.data.amount <= 20000 &&
            getAfter(/databases/$(database)/documents/items/$(itemId)).data.currentBid == request.resource.data.amount &&
            getAfter(/databases/$(database)/documents/items/$(itemId)).data.currentBidderUid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/items/$(itemId)).data.bidCount ==
              get(/databases/$(database)/documents/items/$(itemId)).data.get('bidCount', 0) + 1;
        }
        // A held bid: above HOLD_THRESHOLD (and below BAN_THRESHOLD, see
        // commonBid). It never touches the lot. A reviewer calls the
        // bidder; only an admin can confirm it. One hold per bidder per lot.
        function heldBid() {
          return bidId == 'hold_' + request.auth.uid &&
            request.resource.data.keys().hasOnly(
              ['name', 'phone', 'email', 'amount', 'uid', 'isGoogle', 'deviceId', 'timestamp', 'childName', 'classSection', 'admissionNumber', 'announceName', 'status']) &&
            request.resource.data.status == 'pending' &&
            request.resource.data.amount > 20000 &&
            get(/databases/$(database)/documents/items/$(itemId)).data.active == true &&
            (get(/databases/$(database)/documents/items/$(itemId)).data.get('endsAt', null) == null ||
             request.time < get(/databases/$(database)/documents/items/$(itemId)).data.endsAt);
        }
        allow create: if isVerifiedBidder() && commonBid() && (normalBid() || heldBid());
      }
    }

    // Lets a signed-in bidder list ONLY their own bids across all lots
    // (collection-group query where('uid', '==', <their uid>)). Powers a
    // My Bids that survives a new device. Needs a collection-group index
    // exemption on bids.uid (see firestore.indexes.json).
    match /{path=**}/bids/{bidId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
