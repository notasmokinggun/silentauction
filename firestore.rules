rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────
    // Admin identity is by EMAIL, never Google/UID, and always
    // requires a verified email address:
    //   1. A tiny hardcoded bootstrap list (paste the SAME lowercase
    //      email(s) as ADMIN_EMAILS in firebase-init.js) — how the
    //      very first admin gets in, since nobody exists yet to add
    //      them.
    //   2. Anyone with an approved doc in adminEmails/{email} — written
    //      by admin-access.html (owner adds/removes admins by email)
    //      and by owner-setup.html (the one-time owner claim).
    // ───────────────────────────────────────────────────────────
    function verifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true &&
        request.auth.token.email is string;
    }
    function ownEmail() { return request.auth.token.email.lower(); }
    // A guest placing a bid must be signed in with a real Google account —
    // never anonymous, never a bare uid with no verified provider. This is
    // the server-side half of "every bid has a mandatory user id": the
    // client can't spoof it, since request.auth comes from Firebase's own
    // verified ID token, not from anything the page sends.
    function isVerifiedBidder() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isAdmin() {
      return verifiedEmail() && (
        ownEmail() in [
          // "you@example.com",
        ]
        || (exists(/databases/$(database)/documents/adminEmails/$(ownEmail())) &&
            get(/databases/$(database)/documents/adminEmails/$(ownEmail())).data.approved == true)
      );
    }
    function isOwner() {
      return verifiedEmail() &&
        exists(/databases/$(database)/documents/settings/owner) &&
        get(/databases/$(database)/documents/settings/owner).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/settings/owner).data.email == ownEmail();
    }
    // True only while no owner has been claimed yet AND this write would
    // itself create that owner record for the signed-in user — lets
    // owner-setup.html's one-time claim happen without a chicken-and-egg
    // "you must already be owner to become owner" problem.
    function bootstrapping() {
      return verifiedEmail() &&
        !exists(/databases/$(database)/documents/settings/owner) &&
        getAfter(/databases/$(database)/documents/settings/owner).data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/settings/owner).data.email == ownEmail();
    }

    // Created once by owner-setup.html's one-time claim, keyed uid+email
    // so it can never silently point at a different account later.
    match /settings/owner {
      allow get: if isOwner();
      allow create: if verifiedEmail() &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'setupKey', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.email == ownEmail() &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.setupKey is string &&
        request.resource.data.setupKey.matches('^[a-zA-Z0-9_-]{20,128}$') &&
        get(/databases/$(database)/documents/setupKeys/$(request.resource.data.setupKey)).data.enabled == true &&
        getAfter(/databases/$(database)/documents/setupKeys/$(request.resource.data.setupKey)).data.enabled == false &&
        getAfter(/databases/$(database)/documents/adminEmails/$(ownEmail())).data.role == 'owner' &&
        getAfter(/databases/$(database)/documents/adminEmails/$(ownEmail())).data.approved == true;
      allow update, delete, list: if false;
    }

    // Created only in the Firebase console (Firestore → Data → Start
    // collection "setupKeys" → doc with `enabled: true`). Never readable
    // or creatable from the browser — consuming it and writing the first
    // owner record must happen atomically in the same batch as above.
    match /setupKeys/{key} {
      allow read, create, delete: if false;
      allow update: if bootstrapping() && resource.data.enabled == true &&
        getAfter(/databases/$(database)/documents/settings/owner).data.setupKey == key &&
        request.resource.data.keys().hasOnly(['enabled']) && request.resource.data.enabled == false;
    }

    // admin-access.html: owner adds/removes organizers by email here.
    // The owner's own row can never be edited/removed through this path.
    function initialOwnerApproval(email) {
      return bootstrapping() && email == ownEmail() &&
        request.resource.data.keys().hasOnly(['email', 'approved', 'role', 'updatedBy', 'updatedAt']) &&
        request.resource.data.email == ownEmail() && request.resource.data.approved == true &&
        request.resource.data.role == 'owner' && request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }
    function validApproval(email) {
      return request.resource.data.keys().hasOnly(['email', 'approved', 'role', 'updatedBy', 'updatedAt']) &&
        email == email.lower() && email.size() <= 254 &&
        email.matches('^[^ @/]+@[^ @/]+[.][^ @/]+$') &&
        request.resource.data.email == email &&
        request.resource.data.approved == true &&
        request.resource.data.role == 'admin' &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }
    match /adminEmails/{email} {
      allow get: if isOwner() || (verifiedEmail() && email == ownEmail());
      allow list: if isOwner();
      allow create: if (isOwner() && validApproval(email)) || initialOwnerApproval(email);
      allow update: if (isOwner() && resource.data.role != 'owner' && email != ownEmail() && validApproval(email)) || initialOwnerApproval(email);
      allow delete: if isOwner() && resource.data.role != 'owner' && email != ownEmail();
    }

    // Legacy: an older build briefly wrote admin approvals to admins/{email}
    // (Google-sign-in era). That collection is no longer read by the app —
    // locked out entirely rather than left as a stale backdoor. Re-add
    // anyone who was only approved there through Admin Access instead.
    match /admins/{email} { allow read, write: if false; }

    // A per-device cooldown, checked server-side. A bid transaction writes
    // here alongside its real writes; if the gap since this device's last
    // bid is under 3 seconds, the whole transaction is rejected atomically —
    // no partial bid, no spam-clicking past it. serverTimestamp() sentinels
    // are resolved by Firestore before rules run, so this can't be spoofed
    // by sending a fake future/past client timestamp.
    match /bidLimits/{deviceId} {
      allow read: if true;
      allow write: if request.resource.data.lastBidAt is timestamp &&
        (!exists(/databases/$(database)/documents/bidLimits/$(deviceId)) ||
         request.resource.data.lastBidAt.toMillis() - resource.data.lastBidAt.toMillis() >= 3000);
    }

    // Absurd-bid cooldown. When a device tries to bid above MAX_BID (10
    // crore — see the same constant in firebase-init.js), the client
    // writes a short-lived block here instead of ever attempting the bid,
    // and any bid create underneath /items/{itemId}/bids while this doc
    // is still "in the future" is rejected server-side too (see below) —
    // so this can't be bypassed by skipping the client-side check.
    // The window must land 4–6 minutes out from the server's own clock
    // (never exactly equal, to tolerate normal network/clock skew), which
    // stops a client from writing a block that expires immediately or
    // lasts far longer than intended.
    match /bidBlocks/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['blockedUntil']) &&
        request.resource.data.blockedUntil is timestamp &&
        request.resource.data.blockedUntil > request.time + duration.value(4, 'm') &&
        request.resource.data.blockedUntil <= request.time + duration.value(6, 'm');
      allow delete: if isAdmin();
    }
    // Absolute ceiling on any bid amount — an obviously-absurd value (fat-
    // fingered or malicious) is rejected outright rather than accepted.
    function underMaxBid(amount) { return amount > 0 && amount <= 100000000; }
    function isBlacklisted(deviceId) {
      return exists(/databases/$(database)/documents/bidBlocks/$(deviceId)) &&
        get(/databases/$(database)/documents/bidBlocks/$(deviceId)).data.blockedUntil > request.time;
    }

    // Guest profiles saved by guest-auth.js after Google sign-in (name/
    // email/phone for high-value lots). Unrelated to admin identity.
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'updatedAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 80 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$') &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 30 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Bidding is a straight raise: only currentBid, currentBidderName,
      // currentBidderUid and bidCount may change, currentBid must clear
      // the previous bid by at least the increment, and closed lots
      // reject new bids. Admins can still edit anything (e.g. fixing
      // a typo in the description).
      allow update: if isAdmin() || (
        resource.data.active == true &&
        isVerifiedBidder() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentBid', 'currentBidderName', 'currentBidderUid', 'bidCount']) &&
        request.resource.data.currentBid is number &&
        underMaxBid(request.resource.data.currentBid) &&
        request.resource.data.currentBid >= resource.data.currentBid + resource.data.increment &&
        request.resource.data.currentBidderName is string &&
        request.resource.data.currentBidderName.size() > 0 &&
        request.resource.data.currentBidderName.size() < 80 &&
        request.resource.data.currentBidderUid == request.auth.uid
      );

      match /bids/{bidId} {
        allow read: if true;
        allow update, delete: if isAdmin();
        // A bid document is only ever valid if its uid is the account that
        // is actually signed in right now — a guest can't write someone
        // else's uid, and can't write a bid with no uid at all.
        allow create: if isVerifiedBidder() &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() < 80 &&
          request.resource.data.amount is number &&
          underMaxBid(request.resource.data.amount) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.deviceId is string &&
          !isBlacklisted(request.resource.data.deviceId);
      }
    }
  }
}
